# ============================================================
# Media MCP Studio — Environment Variables (Vercel / local)
# ضع هذه المتغيرات في Vercel: Settings → Environment Variables
# ============================================================

# --- قاعدة بيانات Turso (مطلوبة) ---
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# --- مزود الوسائط KIE.ai ---
# مفتاح افتراضي يُزرع تلقائياً في قاعدة البيانات عند أول تشغيل إذا كان الجدول فارغاً
# (يمكن أيضاً إضافة مفاتيح من لوحة التحكم نفسها)
KIE_API_KEY=your-default-kie-api-key
KIE_BASE_URL=https://api.kie.ai
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co

# الموديلات
KIE_IMAGE_MODEL=gpt-image-2-6/flare-text-to-image
KIE_VIDEO_MODEL=grok-imagine-video-1-5-preview

# مدة الفيديو الافتراضية بالثواني (القيم المدعومة لدى الموديل: 6 أو 10 أو 15)
VIDEO_DURATION_SECONDS=15

# --- الحماية (يُنصح بضبطها قبل النشر) ---
# كلمة مرور لوحة التحكم — إذا تُركت فارغة تكون اللوحة مفتوحة للجميع
ADMIN_PASSWORD=
# سر لنقاط MCP — يُرسل في ترويسة Authorization: Bearer <MCP_SECRET> — إذا تُرك فارغاً تكون النقاط مفتوحة
MCP_SECRET=

# --- أزمنة الانتظار (اختيارية) ---
# أقصى انتظار داخل نداء MCP واحد قبل إرجاع «قيد المعالجة» مع taskId
IMAGE_WAIT_MS=110000
VIDEO_WAIT_MS=110000
MERGE_WAIT_MS=110000
